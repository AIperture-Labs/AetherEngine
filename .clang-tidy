---
Checks: >
  modernize-*,
  cppcoreguidelines-*
WarningsAsErrors: false
HeaderFilterRegex: "(^|/)sources/.+\\.hpp$"
FormatStyle: Google
CheckOptions:
  - key: modernize-use-trailing-return-type
    value: "0"
