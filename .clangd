# Doc: https://clangd.llvm.org/config

If:
  PathExclude:
    - ".clang*"

CompileFlags:
  CompilationDatabase: .
  BuiltinHeaders: QueryDriver
  Add:
    - -std=c++23

Diagnostics:
  UnusedIncludes: Strict

Index:
  Background: Build

InlayHints:
  BlockEnd: false
  Designators: true
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  DefaultArguments: false
  TypeNameLimit: 24

Completion:
  AllScopes: true
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU
  CodePatterns: All
