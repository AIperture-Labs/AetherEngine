# CLion
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#cmake-build-*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
out/**/*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Build
build/
out/
.cache/

# Tracy
tools/tracy
.aider*

# Temporary directories
.tmp/
.temp/
temp/
tmp/

# UV Runtime
runtimes/uv/
configs/runtimes/uv/uv.toml

# Python Runtime
runtimes/python/

# Agent tooling
#  AGENTS.md and .agents/ are the tracked source of truth. CLAUDE.md and .claude/ are
#  tracked symlinks pointing at them. Only the volatile contents of .agents/ are ignored.
.agents/**/*.local.json
# The generic build/ rule above would otherwise swallow the build skill.
!.agents/skills/build/

# Git worktrees
#  Agents check these out under .agents/worktrees/ (reached as .claude/worktrees/).
#  The generic patterns also catch worktrees created at any other depth.
.agents/worktrees/
worktrees/
.worktrees/